# Copie para .env e preencha com valores reais. Nunca faça commit do .env.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (usado pelo Docker e pelo backend)
POSTGRES_USER=rafaela
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=rafaela_gestao
DATABASE_URL=postgresql://rafaela:troque-por-uma-senha-forte@localhost:5432/rafaela_gestao

# Opcional: banco dos testes de integração (padrão: DATABASE_URL com sufixo _test)
# TEST_DATABASE_URL=postgresql://rafaela:troque-por-uma-senha-forte@localhost:5432/rafaela_gestao_test

# Usuárias criadas por "npm run db:seed" (senha com no mínimo 10 caracteres)
SEED_DANIELA_EMAIL=daniela@example.com
SEED_DANIELA_PASSWORD=troque-esta-senha
SEED_RAFAELA_EMAIL=rafaela@example.com
SEED_RAFAELA_PASSWORD=troque-esta-senha
