{
  "name": "rafaela-colussi-backend",
  "private": "true",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "db:up": "docker compose --env-file .env -f ../docker-compose.yml up -d",
    "db:down": "docker compose --env-file .env -f ../docker-compose.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/database/migrate.ts",
    "db:seed": "tsx --env-file=.env src/database/seed.ts",
    "user:set-password": "tsx --env-file=.env src/scripts/set-password.ts",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration"
  },
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "prettier": "3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
